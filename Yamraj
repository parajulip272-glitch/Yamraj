<!DOCTYPE html>
<html lang="ne">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yamraj Gosai - Official Website</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
            color: #fff;
            min-height: 100vh;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(90deg, #e94560, #ff7b54);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav ul li a {
            color: #fff;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #e94560;
        }

        /* Hero Section */
        .hero {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-height: 85vh;
            padding: 40px 20px;
        }

        .hero-img {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e94560, #ff7b54);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 4rem;
            margin-bottom: 30px;
            box-shadow: 0 0 40px rgba(233, 69, 96, 0.5);
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
            background: linear-gradient(90deg, #e94560, #ff7b54, #ffd93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.2rem;
            color: #b8b8d1;
            max-width: 600px;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .btn {
            display: inline-block;
            padding: 14px 40px;
            background: linear-gradient(90deg, #e94560, #ff7b54);
            color: #fff;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            transition: transform 0.3s, box-shadow 0.3s;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(233, 69, 96, 0.5);
        }

        /* Sections */
        section {
            padding: 80px 8%;
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 50px;
            color: #fff;
        }

        .section-title span {
            color: #e94560;
        }

        /* About */
        .about-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
            font-size: 1.1rem;
            line-height: 1.8;
            color: #b8b8d1;
        }

        /* Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            transition: transform 0.3s, background 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
            background: rgba(233, 69, 96, 0.1);
        }

        .card .icon {
            font-size: 3rem;
            margin-bottom: 20px;
        }

        .card h3 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: #ff7b54;
        }

        .card p {
            color: #b8b8d1;
            line-height: 1.6;
        }

        /* Contact */
        .contact-form {
            max-width: 500px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .contact-form input,
        .contact-form textarea {
            padding: 15px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: border 0.3s;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #e94560;
        }

        .contact-form textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 30px;
            background: rgba(0, 0, 0, 0.3);
            color: #b8b8d1;
            font-size: 0.9rem;
        }

        footer span {
            color: #e94560;
        }

        /* Mobile */
        @media (max-width: 768px) {
            nav ul { display: none; }
            .hero h1 { font-size: 2.2rem; }
            .section-title { font-size: 1.8rem; }
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav>
        <div class="logo">Yamraj Gosai</div>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero -->
    <section class="hero" id="home">
        <div class="hero-img">🙏</div>
        <h1>Yamraj Gosai</h1>
        <p>Welcome to the official website of Yamraj Gosai. Dedicated to spirituality, culture, and community service.</p>
        <a href="#about" class="btn">Learn More</a>
    </section>

    <!-- About -->
    <section id="about">
        <h2 class="section-title">About <span>Us</span></h2>
        <div class="about-content">
            <p>Yamraj Gosai is a platform dedicated to preserving and promoting our rich cultural heritage, spiritual values, and community traditions. We believe in spreading positivity, knowledge, and service to society.</p>
        </div>
    </section>

    <!-- Services -->
    <section id="services">
        <h2 class="section-title">Our <span>Services</span></h2>
        <div class="cards">
            <div class="card">
                <div class="icon">🕉️</div>
                <h3>Spiritual Guidance</h3>
                <p>Providing spiritual knowledge and guidance to help you find inner peace and purpose.</p>
            </div>
            <div class="card">
                <div class="icon">🎭</div>
                <h3>Cultural Events</h3>
                <p>Organizing cultural programs and events to celebrate our traditions and heritage.</p>
            </div>
            <div class="card">
                <div class="icon">🤝</div>
                <h3>Community Service</h3>
                <p>Working together for the welfare of the community through various social initiatives.</p>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact">
        <h2 class="section-title">Contact <span>Us</span></h2>
        <form class="contact-form" onsubmit="sendMessage(event)">
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea placeholder="Your Message" required></textarea>
            <button type="submit" class="btn">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2024 <span>Yamraj Gosai</span>. All Rights Reserved.</p>
    </footer>

    <script>
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Contact form
        function sendMessage(event) {
            event.preventDefault();
            alert('धन्यवाद! तपाईंको सन्देश पठाइयो। 🙏');
            event.target.reset();
        }
    </script>

</body>
</html>
